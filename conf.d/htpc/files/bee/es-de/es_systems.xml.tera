<?xml version="1.0"?>
<!-- bee: generated by mise from ~/.config/mise/files/bee/es-de/es_systems.xml.tera — edit the template, not this file.
     Folder names are Batocera's (as on the NAS); platform/theme are ES-DE's.
     Paths: systems in [vars] bee_local_systems are read from the local mirror, the rest from the read-only NAS mount. -->
{% set local = vars.bee_local_systems | split(pat=" ") %}
<systemList>
    <system>
        <name>nes</name>
        <fullname>Nintendo Entertainment System</fullname>
        <path>{% if "nes" in local %}{{ env.HOME }}/Games/roms/nes{% else %}/mnt/nasro/media/library/roms/nes{% endif %}</path>
        <extension>.3dsen .3DSEN .fds .FDS .nes .NES .unf .UNF .unif .UNIF .7z .7Z .zip .ZIP</extension>
        <command label="FCEUmm / Nestopia UE">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh nes fceumm,nestopia %ROM%</command>
        <platform>nes</platform>
        <theme>nes</theme>
    </system>
    <system>
        <name>snes</name>
        <fullname>Nintendo SNES (Super Nintendo)</fullname>
        <path>{% if "snes" in local %}{{ env.HOME }}/Games/roms/snes{% else %}/mnt/nasro/media/library/roms/snes{% endif %}</path>
        <extension>.bin .BIN .bml .BML .bs .BS .bsx .BSX .dx2 .DX2 .fig .FIG .gd3 .GD3 .gd7 .GD7 .mgd .MGD .sfc .SFC .smc .SMC .st .ST .swc .SWC .7z .7Z .zip .ZIP</extension>
        <command label="Snes9x">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh snes snes9x %ROM%</command>
        <platform>snes</platform>
        <theme>snes</theme>
    </system>
    <system>
        <name>gbc</name>
        <fullname>Nintendo Game Boy Color</fullname>
        <path>{% if "gbc" in local %}{{ env.HOME }}/Games/roms/gbc{% else %}/mnt/nasro/media/library/roms/gbc{% endif %}</path>
        <extension>.bs .BS .cgb .CGB .dmg .DMG .gb .GB .gbc .GBC .gbx .GBX .sgb .SGB .sfc .SFC .smc .SMC .7z .7Z .zip .ZIP</extension>
        <command label="Gambatte">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh gbc gambatte %ROM%</command>
        <platform>gbc</platform>
        <theme>gbc</theme>
    </system>
    <system>
        <name>gba</name>
        <fullname>Nintendo Game Boy Advance</fullname>
        <path>{% if "gba" in local %}{{ env.HOME }}/Games/roms/gba{% else %}/mnt/nasro/media/library/roms/gba{% endif %}</path>
        <extension>.agb .AGB .bin .BIN .cgb .CGB .dmg .DMG .gb .GB .gba .GBA .gbc .GBC .gbx .GBX .sgb .SGB .7z .7Z .zip .ZIP</extension>
        <command label="mGBA">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh gba mgba %ROM%</command>
        <platform>gba</platform>
        <theme>gba</theme>
    </system>
    <system>
        <name>megadrive</name>
        <fullname>Sega Mega Drive</fullname>
        <path>{% if "megadrive" in local %}{{ env.HOME }}/Games/roms/megadrive{% else %}/mnt/nasro/media/library/roms/megadrive{% endif %}</path>
        <extension>.32x .32X .68k .68K .bin .BIN .bms .BMS .chd .CHD .cue .CUE .gen .GEN .gg .GG .iso .ISO .m3u .M3U .md .MD .mdx .MDX .sg .SG .sgd .SGD .smd .SMD .sms .SMS .7z .7Z .zip .ZIP</extension>
        <command label="Genesis Plus GX">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh megadrive genesis_plus_gx %ROM%</command>
        <platform>megadrive</platform>
        <theme>megadrive</theme>
    </system>
    <system>
        <name>n64</name>
        <fullname>Nintendo 64</fullname>
        <path>{% if "n64" in local %}{{ env.HOME }}/Games/roms/n64{% else %}/mnt/nasro/media/library/roms/n64{% endif %}</path>
        <extension>.AppImage .bin .BIN .d64 .D64 .desktop .n64 .N64 .ndd .NDD .sh .u1 .U1 .v64 .V64 .z64 .Z64 .7z .7Z .zip .ZIP</extension>
        <command label="Mupen64Plus-Next">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh n64 mupen64plus_next %ROM%</command>
        <platform>n64</platform>
        <theme>n64</theme>
    </system>
    <system>
        <name>nds</name>
        <fullname>Nintendo DS</fullname>
        <path>{% if "nds" in local %}{{ env.HOME }}/Games/roms/nds{% else %}/mnt/nasro/media/library/roms/nds{% endif %}</path>
        <extension>.app .APP .bin .BIN .dsi .DSI .ids .IDS .nds .NDS .7z .7Z .zip .ZIP</extension>
        <command label="melonDS">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh nds melonds %ROM%</command>
        <platform>nds</platform>
        <theme>nds</theme>
    </system>
    <system>
        <name>psx</name>
        <fullname>Sony PlayStation</fullname>
        <path>{% if "psx" in local %}{{ env.HOME }}/Games/roms/psx{% else %}/mnt/nasro/media/library/roms/psx{% endif %}</path>
        <extension>.cbn .CBN .ccd .CCD .chd .CHD .cue .CUE .ecm .ECM .exe .EXE .img .IMG .iso .ISO .m3u .M3U .mdf .MDF .mds .MDS .minipsf .MINIPSF .pbp .PBP .psexe .PSEXE .psf .PSF .toc .TOC .z .Z .znx .ZNX .7z .7Z .zip .ZIP</extension>
        <command label="SwanStation / Beetle PSX HW">/bin/bash {{ env.HOME }}/.config/mise/files/bee/bin/bee-ra.sh psx swanstation,mednafen_psx_hw %ROM%</command>
        <platform>psx</platform>
        <theme>psx</theme>
    </system>
    <system>
        <name>psp</name>
        <fullname>Sony PlayStation Portable</fullname>
        <path>{% if "psp" in local %}{{ env.HOME }}/Games/roms/psp{% else %}/mnt/nasro/media/library/roms/psp{% endif %}</path>
        <extension>.chd .CHD .cso .CSO .elf .ELF .iso .ISO .pbp .PBP .prx .PRX .7z .7Z .zip .ZIP</extension>
        <command label="PPSSPP (Standalone)">%EMULATOR_PPSSPP% %ROM%</command>
        <platform>psp</platform>
        <theme>psp</theme>
    </system>
    <system>
        <name>ps2</name>
        <fullname>Sony PlayStation 2</fullname>
        <path>{% if "ps2" in local %}{{ env.HOME }}/Games/roms/ps2{% else %}/mnt/nasro/media/library/roms/ps2{% endif %}</path>
        <extension>.bin .BIN .chd .CHD .ciso .CISO .cso .CSO .desktop .dump .DUMP .elf .ELF .gz .GZ .m3u .M3U .mdf .MDF .img .IMG .iso .ISO .isz .ISZ .ngr .NRG .zso .ZSO</extension>
        <command label="PCSX2 (Standalone)">%EMULATOR_PCSX2% -batch %ROM%</command>
        <platform>ps2</platform>
        <theme>ps2</theme>
    </system>
    <system>
        <name>ps3</name>
        <fullname>Sony PlayStation 3</fullname>
        <path>{% if "ps3" in local %}{{ env.HOME }}/Games/roms/ps3{% else %}/mnt/nasro/media/library/roms/ps3{% endif %}</path>
        <extension>.desktop .iso .ISO .ps3 .PS3 .ps3dir .PS3DIR</extension>
        <command label="RPCS3 Directory (Standalone)">%EMULATOR_RPCS3% --no-gui %ROM%</command>
        <platform>ps3</platform>
        <theme>ps3</theme>
    </system>
    <system>
        <name>ps4</name>
        <fullname>Sony PlayStation 4</fullname>
        <path>{% if "ps4" in local %}{{ env.HOME }}/Games/roms/ps4{% else %}/mnt/nasro/media/library/roms/ps4{% endif %}</path>
        <extension>.bin .BIN .desktop .ps4 .PS4</extension>
        <command label="shadPS4 (Standalone)">%EMULATOR_SHADPS4% %ROM%</command>
        <platform>ps4</platform>
        <theme>ps4</theme>
    </system>
    <system>
        <name>gamecube</name>
        <fullname>Nintendo GameCube</fullname>
        <path>{% if "gamecube" in local %}{{ env.HOME }}/Games/roms/gamecube{% else %}/mnt/nasro/media/library/roms/gamecube{% endif %}</path>
        <extension>.ciso .CISO .dff .DFF .dol .DOL .elf .ELF .gcm .GCM .gcz .GCZ .iso .ISO .json .JSON .m3u .M3U .rvz .RVZ .tgc .TGC .wad .WAD .wbfs .WBFS .wia .WIA .7z .7Z .zip .ZIP</extension>
        <command label="Dolphin (Standalone)">%INJECT%=%BASENAME%.esprefix %EMULATOR_DOLPHIN% -b -e %ROM%</command>
        <platform>gc</platform>
        <theme>gc</theme>
    </system>
    <system>
        <name>wii</name>
        <fullname>Nintendo Wii</fullname>
        <path>{% if "wii" in local %}{{ env.HOME }}/Games/roms/wii{% else %}/mnt/nasro/media/library/roms/wii{% endif %}</path>
        <extension>.ciso .CISO .dff .DFF .dol .DOL .elf .ELF .gcm .GCM .gcz .GCZ .iso .ISO .json .JSON .m3u .M3U .rvz .RVZ .tgc .TGC .wad .WAD .wbfs .WBFS .wia .WIA .7z .7Z .zip .ZIP</extension>
        <command label="Dolphin (Standalone)">%INJECT%=%BASENAME%.esprefix %EMULATOR_DOLPHIN% -b -e %ROM%</command>
        <platform>wii</platform>
        <theme>wii</theme>
    </system>
    <system>
        <name>wiiu</name>
        <fullname>Nintendo Wii U</fullname>
        <path>{% if "wiiu" in local %}{{ env.HOME }}/Games/roms/wiiu{% else %}/mnt/nasro/media/library/roms/wiiu{% endif %}</path>
        <extension>.elf .ELF .rpx .RPX .tmd .TMD .wua .WUA .wud .WUD .wuhb .WUHB .wux .WUX</extension>
        <command label="Cemu (Standalone)">%EMULATOR_CEMU% -g %ROM%</command>
        <platform>wiiu</platform>
        <theme>wiiu</theme>
    </system>
    <system>
        <name>switch</name>
        <fullname>Nintendo Switch</fullname>
        <path>{% if "switch" in local %}{{ env.HOME }}/Games/roms/switch{% else %}/mnt/nasro/media/library/roms/switch{% endif %}</path>
        <extension>.nca .NCA .nro .NRO .nso .NSO .nsp .NSP .xci .XCI</extension>
        <command label="Ryujinx (Standalone)">%EMULATOR_RYUJINX% %ROM%</command>
        <platform>switch</platform>
        <theme>switch</theme>
    </system>
    <system>
        <name>3ds</name>
        <fullname>Nintendo 3DS</fullname>
        <path>{% if "3ds" in local %}{{ env.HOME }}/Games/roms/3ds{% else %}/mnt/nasro/media/library/roms/3ds{% endif %}</path>
        <extension>.3ds .3DS .3dsx .3DSX .app .APP .axf .AXF .cci .CCI .cxi .CXI .desktop .elf .ELF .z3dsx .Z3DSX .zcci .ZCCI .zcxi .ZCXI .7z .7Z .zip .ZIP</extension>
        <command label="Azahar (Standalone)">%EMULATOR_AZAHAR% %ROM%</command>
        <platform>n3ds</platform>
        <theme>n3ds</theme>
    </system>
    <system>
        <name>xbox</name>
        <fullname>Microsoft Xbox</fullname>
        <path>{% if "xbox" in local %}{{ env.HOME }}/Games/roms/xbox{% else %}/mnt/nasro/media/library/roms/xbox{% endif %}</path>
        <extension>.iso .ISO .xiso .XISO</extension>
        <command label="xemu (Standalone)">%INJECT%=%BASENAME%.esprefix %EMULATOR_XEMU% -dvd_path %ROM%</command>
        <platform>xbox</platform>
        <theme>xbox</theme>
    </system>
    <system>
        <name>xbox360</name>
        <fullname>Microsoft Xbox 360</fullname>
        <path>{% if "xbox360" in local %}{{ env.HOME }}/Games/roms/xbox360{% else %}/mnt/nasro/media/library/roms/xbox360{% endif %}</path>
        <extension>. .desktop .iso .ISO .sh .xex .XEX .zar .ZAR</extension>
        <command label="xenia Canary (Standalone)">%STARTDIR%=%EMUDIR% %EMULATOR_XENIA% %INJECT%=%BASENAME%.commands %ROM%</command>
        <platform>xbox360</platform>
        <theme>xbox360</theme>
    </system>
    <system>
        <name>steam</name>
        <fullname>Valve Steam</fullname>
        <path>{% if "steam" in local %}{{ env.HOME }}/Games/roms/steam{% else %}/mnt/nasro/media/library/roms/steam{% endif %}</path>
        <extension>.desktop .sh</extension>
        <command label="Steam (Standalone)">%RUNINBACKGROUND% %ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>steam</platform>
        <theme>steam</theme>
    </system>
</systemList>
